[
  {
    "name": "Semester",
    "bcId": "bc-registry",
    "aggregateRoot": "Semester",
    "responsibility": "学期主数据及其作息模板引用关系，是排课与数据归集的时间基线",
    "attributes": [
      "semesterId",
      "name",
      "academicYear",
      "startDate",
      "endDate",
      "status",
      "scheduleTemplateId"
    ],
    "entities": [],
    "valueObjects": [
      {
        "name": "DateRange",
        "attributes": [
          "startDate",
          "endDate"
        ]
      }
    ],
    "references": [
      {
        "class": "ScheduleTemplate",
        "domain": "bc-registry",
        "fields": [
          "scheduleTemplateId"
        ]
      }
    ],
    "sourceUserStoryIds": [
      "US-BD-001",
      "US-BD-002",
      "US-LG-002"
    ],
    "invariants": [
      {
        "description": "每个学期仅引用一个作息模板，新增学期必须绑定现有作息模板",
        "triggerCommandRefs": [
          "CreateSemester",
          "UpdateSemester"
        ],
        "violationBehavior": "拒绝保存并提示，未绑定模板的学期不可进入一键排课"
      },
      {
        "description": "已存档学期只读可导出，不可编辑",
        "triggerCommandRefs": [
          "UpdateSemester"
        ],
        "violationBehavior": "拒绝编辑并提示只读"
      }
    ],
    "stateModeling": {
      "decision": "DataOnly",
      "reason": "学期状态四值中，未开始/进行中/已结束为日期派生态（由起止日期相对当前日实时计算），仅已存档为命令驱动只读存储态；故不建状态机，状态字段只存三个存储态，已结束为展示派生。",
      "stateMachineRefs": [],
      "openQuestions": []
    }
  },
