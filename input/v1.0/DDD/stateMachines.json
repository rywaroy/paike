[
  {
    "id": "TimetablePlanLifecycle",
    "ownerAggregate": "TimetablePlan",
    "targetClass": "TimetablePlan",
    "stateField": "status",
    "states": [
      {
        "name": "Draft",
        "isInitial": true,
        "isTerminal": false,
        "value": "Draft"
      },
      {
        "name": "Published",
        "isInitial": false,
        "isTerminal": false,
        "value": "Published"
      },
      {
        "name": "Archived",
        "isInitial": false,
        "isTerminal": true,
        "value": "Archived"
      }
    ],
    "transitions": [
      {
        "from": "Draft",
        "to": "Published",
        "trigger": "PublishPlan",
        "condition": "草稿方案通过预览确认并发布为正式课表",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Published",
        "to": "Archived",
        "trigger": "ArchivePlan",
        "condition": "已发布正式课表随学期存档",
        "variablesChanged": [
          "status"
        ]
      }
    ],
    "initializations": [
      {
        "trigger": "RegeneratePlan",
        "state": "Draft",
        "condition": "一键排课基于学期与作息模板生成草稿方案"
      }
    ],
    "sourceUserStoryIds": [
      "US-AP-001",
      "US-AP-003",
      "US-LG-002"
    ]
  },
  {
    "id": "LessonLockState",
    "ownerAggregate": "TimetablePlan",
    "targetClass": "LessonOccurrence",
    "stateField": "locked",
    "states": [
      {
        "name": "Unlocked",
        "isInitial": true,
        "isTerminal": false,
        "value": false
      },
      {
        "name": "Locked",
        "isInitial": false,
        "isTerminal": false,
        "value": true
      }
    ],
    "transitions": [
      {
        "from": "Unlocked",
        "to": "Locked",
        "trigger": "LockLesson",
        "condition": "对未锁定课程执行锁定",
        "variablesChanged": [
          "locked"
        ]
      },
      {
        "from": "Locked",
        "to": "Unlocked",
        "trigger": "UnlockLesson",
        "condition": "对已锁定课程执行解锁",
        "variablesChanged": [
          "locked"
        ]
      },
      {
        "from": "Locked",
        "to": "Locked",
        "trigger": "RegeneratePlan",
        "condition": "自动排课保留已锁定课程不变",
        "variablesChanged": []
      },
      {
        "from": "Unlocked",
        "to": "Unlocked",
        "trigger": "MoveLesson",
        "condition": "仅未锁定课程可移动，移动后仍为未锁定",
        "variablesChanged": []
      },
      {
        "from": "Unlocked",
        "to": "Unlocked",
        "trigger": "RegeneratePlan",
        "condition": "未锁定课程重排后仍为未锁定，不自动加锁",
        "variablesChanged": []
      }
    ],
    "initializations": [
      {
        "trigger": "RegeneratePlan",
        "state": "Unlocked",
        "condition": "一键排课生成的课程课次初始为未锁定"
      }
    ],
    "sourceUserStoryIds": [
      "US-AP-004",
      "US-AT-003"
    ]
  }
]
